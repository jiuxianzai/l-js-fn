{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationDir": "dist",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": ["ES2020", "DOM", "dom.iterable"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "__tests__", "tsup.config.ts"],
	"exclude": ["node_modules", "dist"]
}
