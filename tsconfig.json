{
	"compilerOptions": {
		"target": "ES2019",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"declaration": true,
		"declarationDir": "dist",
		"outDir": "dist",
		"strict": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2019", "DOM", "dom.iterable"],
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["src", "__tests__", "tsup.config.ts"],
	"exclude": ["node_modules", "dist"]
}
