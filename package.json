{
	"name": "l-js-fn",
	"version": "3.4.2",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./bom": {
			"types": "./dist/bom/index.d.ts",
			"import": "./dist/bom/index.js",
			"require": "./dist/bom/index.cjs"
		},
		"./ws": {
			"types": "./dist/ws/index.d.ts",
			"import": "./dist/ws/index.js",
			"require": "./dist/ws/index.cjs"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js",
			"require": "./dist/config/index.cjs"
		},
		"./ipc": {
			"types": "./dist/ipc/index.d.ts",
			"import": "./dist/ipc/index.js",
			"require": "./dist/ipc/index.cjs"
		},
		"./polling": {
			"types": "./dist/polling/index.d.ts",
			"import": "./dist/polling/index.js",
			"require": "./dist/polling/index.cjs"
		},
		"./regex": {
			"types": "./dist/regex/index.d.ts",
			"import": "./dist/regex/index.js",
			"require": "./dist/regex/index.cjs"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js",
			"require": "./dist/storage/index.cjs"
		},
		"./encode": {
			"types": "./dist/encode/index.d.ts",
			"import": "./dist/encode/index.js",
			"require": "./dist/encode/index.cjs"
		},
		"./file": {
			"types": "./dist/file/index.d.ts",
			"import": "./dist/file/index.js",
			"require": "./dist/file/index.cjs"
		}
	},
	"scripts": {
		"prepare": "husky install",
		"clean": "rimraf dist",
		"reload": "rimraf package-lock.json && rimraf node_modules && npm install",
		"dev": "tsup src/index.ts --format esm,cjs --dts --minify --treeshake --watch",
		"build": "npm run clean && tsup",
		"test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest",
		"test:coverage": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"test:watch": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"publish:npm": "npm run build && npm publish",
		"publish:major": "npm version major && npm run publish:npm",
		"publish:feat": "npm version minor && npm run publish:npm",
		"publish:fix": "npm version patch && npm run publish:npm",
		"publish:pre": "npm version prerelease --preid=beta && npm run publish:npm"
	},
	"keywords": [
		"javascript",
		"typescript",
		"utility",
		"utils",
		"toolkit",
		"helper",
		"functions",
		"methods",
		"esm",
		"commonjs",
		"tree-shaking",
		"modular",
		"lightweight",
		"bom",
		"websocket",
		"polling",
		"regex",
		"date",
		"array",
		"object",
		"string"
	],
	"author": "jiuxianzai",
	"license": "ISC",
	"description": "轻量级 JavaScript 工具函数库，支持模块化导入和 Tree-shaking",
	"readme": "",
	"sideEffects": false,
	"engines": {
		"node": ">=14.0.0"
	},
	"files": [
		"dist/"
	],
	"private": false,
	"devDependencies": {
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.6.1",
		"husky": "^8.0.3",
		"jest": "^30.2.0",
		"rimraf": "^6.0.1",
		"ts-jest": "^29.4.6",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitepress": "^1.6.4"
	}
}
