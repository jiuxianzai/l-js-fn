{
	"name": "l-js-fn",
	"version": "3.0.0",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./bom": {
			"types": "./dist/bom/index.d.ts",
			"import": "./dist/bom/index.js",
			"require": "./dist/bom/index.cjs"
		},
		"./ws": {
			"types": "./dist/ws/index.d.ts",
			"import": "./dist/ws/index.js",
			"require": "./dist/ws/index.cjs"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"import": "./dist/config/index.js",
			"require": "./dist/config/index.cjs"
		},
		"./ipc": {
			"types": "./dist/ipc/index.d.ts",
			"import": "./dist/ipc/index.js",
			"require": "./dist/ipc/index.cjs"
		},
		"./regex": {
			"types": "./dist/regex/index.d.ts",
			"import": "./dist/regex/index.js",
			"require": "./dist/regex/index.cjs"
		},
		"./polling": {
			"types": "./dist/polling/index.d.ts",
			"import": "./dist/polling/index.js",
			"require": "./dist/polling/index.cjs"
		}
	},
	"scripts": {
		"prepare": "husky install",
		"clean": "rimraf dist",
		"reload": "rimraf package-lock.json && rimraf node_modules && npm install",
		"dev": "tsup src/index.ts --format esm,cjs --dts --minify --treeshake --watch",
		"build": "npm run clean && tsup",
		"publish:npm": "npm run build && npm publish",
		"publish:major": "npm version major && npm run publish:npm",
		"publish:feat": "npm version minor && npm run publish:npm",
		"publish:fix": "npm version patch && npm run publish:npm",
		"publish:pre": "npm version prerelease --preid=beta && npm run publish:npm",
		"test": "NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-vm-modules jest"
	},
	"keywords": [
		"javascript",
		"lib",
		"js-utils",
		"js-function"
	],
	"author": "jiuxianzai",
	"license": "ISC",
	"description": "整理了常用的js方法",
	"files": [
		"dist/"
	],
	"private": false,
	"devDependencies": {
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/node": "^24.6.1",
		"husky": "^8.0.3",
		"jest": "^30.2.0",
		"rimraf": "^6.0.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
