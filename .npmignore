# 忽略 node_modules（即使 npm 默认忽略，保险起见可以写上）
node_modules/
**/*.d.cts
# 忽略测试文件
test/

# 忽略配置文件
.env
.git
.vscode
.DS_Store
.idea/

# 忽略所有 md 文档（私人项目，不发布到 npm）
*.md
!dist/**/*.md

# 明确排除根目录的 md 文档（npm 默认会包含 README，使用多种模式确保排除）
README*
CHANGELOG*
CLAUDE*
CONTRIBUTING*
VERSIONING*

# 忽略文本文件
*.txt

# 忽略测试包
packages/

__tests__/

# 忽略测试覆盖率报告
coverage/
*.lcov
lcov.info

# 忽略 TypeDoc 配置（不需要发布）
typedoc.json

# 忽略开发相关
.eslintrc*
.prettier*
.editorconfig